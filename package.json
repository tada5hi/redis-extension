{
    "name": "redis-extension",
    "version": "3.0.0",
    "description": "Key watchers, typed values, scoreboards and key paths for ioredis clients and clusters.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build:js": "tsdown",
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:js",
        "lint": "eslint src AGENTS.md CLAUDE.md .agents",
        "lint:fix": "npm run lint -- --fix",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.mts",
        "test:coverage": "npm test -- --coverage",
        "release": "npm run build && monoship"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "license": "MIT",
    "keywords": [
        "redis",
        "ioredis",
        "redis-cluster",
        "keyspace-notifications",
        "watcher",
        "cache",
        "json",
        "leaderboard",
        "sorted-set",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tada5hi/redis-extension.git"
    },
    "bugs": {
        "url": "https://github.com/tada5hi/redis-extension/issues"
    },
    "homepage": "https://github.com/tada5hi/redis-extension#readme",
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.2.7",
        "@tada5hi/eslint-config": "^3.3.1",
        "@tada5hi/tsconfig": "^0.7.0",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.14.0",
        "husky": "^9.1.7",
        "ioredis": "^6.0.0",
        "monoship": "^2.2.1",
        "testcontainers": "^12.2.1",
        "tsdown": "^0.23.7",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    },
    "peerDependencies": {
        "ioredis": "^6.0.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.15.0 || >=26.0.0",
            "onFail": "warn"
        }
    }
}
